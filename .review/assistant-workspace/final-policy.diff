+// Defaults mirror the catalogue's access floor. Policy ranges can tighten a
+// capability, but cannot turn a member into an administrator.
+export function defaultAssistantToolRule(tool: AssistantCatalogTool): AssistantToolRule {
+  return { min_level: tool.access === 'root' ? 6 : tool.access === 'admin' ? 5 : tool.access === 'l1' ? 1 : 0, max_level: tool.access === 'l0' ? 0 : 6 }
+}
+export function assistantToolRule(policy: AssistantToolPolicy, tool: AssistantCatalogTool): AssistantToolRule {
+  return policy.rules?.[tool.name] ?? defaultAssistantToolRule(tool)
+}
+export function updateAssistantToolRule(policy: AssistantToolPolicy, name: string, rule?: AssistantToolRule): string {
+  const rules = { ...policy.rules }
+  if (rule) rules[name] = rule
+  else delete rules[name]
+  const { rules: _previous, ...rest } = policy
+  return JSON.stringify({ ...rest, ...(Object.keys(rules).length ? { rules } : {}) })
+}
+export function weeklyDiscountLimit(rule: AssistantToolRule, level: number): number {
+  return rule.discount_percent_by_level?.[String(level)] ?? (level >= 5 ? 0 : 10)
+}
+function parseAssistantToolRules(value: unknown): Record<string, AssistantToolRule> | null | undefined {
+  if (value === undefined) return undefined
+  const rules = record(value)
+  if (!rules) return null
+  for (const [name, source] of Object.entries(rules)) {
+    const rule = record(source)
+    if (!identifier.test(name) || !rule || !Number.isInteger(rule.min_level) || !Number.isInteger(rule.max_level) || Number(rule.min_level) < 0 || Number(rule.max_level) > 6 || Number(rule.min_level) > Number(rule.max_level)) return null
+    if (Object.keys(rule).some((key) => !['min_level', 'max_level', 'discount_percent_by_level', 'market_service_ids', 'default_visibility'].includes(key))) return null
+    if ('discount_percent_by_level' in rule) {
+      const limits = record(rule.discount_percent_by_level)
+      if (name !== 'prepare_weekly_discount' || !limits || Object.entries(limits).some(([level, limit]) => !/^[0-6]$/.test(level) || !Number.isInteger(limit) || Number(limit) < 0 || Number(limit) > 99 || (Number(level) >= 5 && limit !== 0))) return null
+    }
+    if ('market_service_ids' in rule) {
+      const ids = rule.market_service_ids
+      if (name !== 'call_market_tool' || !Array.isArray(ids) || ids.length > 64 || ids.some((id) => typeof id !== 'string' || !id.trim() || id.trim() !== id || new TextEncoder().encode(id).length > 128) || new Set(ids).size !== ids.length) return null
+    }
+    if ('default_visibility' in rule && (name !== 'create_site_issue' || !['user', 'admin'].includes(String(rule.default_visibility)))) return null
+  }
+  return rules as Record<string, AssistantToolRule>
+}
+function stableValue(value: unknown): string {
+  if (Array.isArray(value)) return JSON.stringify([...value].sort())
+  if (value && typeof value === 'object') return JSON.stringify(Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b)).map(([key, item]) => [key, stableValue(item)])))
+  return JSON.stringify(value) ?? ''
+}
+function mergeRuleMaps(before: AssistantToolPolicy['rules'], local: AssistantToolPolicy['rules'], remote: AssistantToolPolicy['rules']): Pick<AssistantToolPolicy, 'rules'> {
+  const rules: Record<string, AssistantToolRule> = {}
+  const names = new Set([...Object.keys(before ?? {}), ...Object.keys(local ?? {}), ...Object.keys(remote ?? {})])
+  for (const name of [...names].sort()) {
+    const b = before?.[name], l = local?.[name], r = remote?.[name]
+    const localChanged = stableValue(l) !== stableValue(b), remoteChanged = stableValue(r) !== stableValue(b)
+    const chosen = localChanged ? l : r
+    if (!localChanged || !remoteChanged || stableValue(l) === stableValue(r)) {
+      if (chosen) rules[name] = chosen
+      continue
+    }
+    // Concurrent edits to one rule use the intersection. The save flow pauses
+    // for review; an empty level intersection is deliberately invalid.
+    const merged: AssistantToolRule = { min_level: Math.max(l?.min_level ?? 0, r?.min_level ?? 0), max_level: Math.min(l?.max_level ?? 6, r?.max_level ?? 6) }
+    if (name === 'prepare_weekly_discount') merged.discount_percent_by_level = Object.fromEntries(Array.from({ length: 7 }, (_, level) => [String(level), Math.min(weeklyDiscountLimit(l ?? {min_level:0,max_level:6}, level), weeklyDiscountLimit(r ?? {min_level:0,max_level:6}, level))]))
+    if (name === 'call_market_tool') merged.market_service_ids = (l?.market_service_ids ?? []).filter((id) => r?.market_service_ids?.includes(id)).sort()
+    if (name === 'create_site_issue') merged.default_visibility = l?.default_visibility === 'admin' || r?.default_visibility === 'admin' ? 'admin' : 'user'
+    rules[name] = merged
+  }
+  return Object.keys(rules).length ? { rules } : {}
+}
