{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extore.lmm.best/api/integrations/commerce/schema",
  "title": "Extore commerce import protocol v1",
  "description": "Structural validation only. Requests reject unknown fields; responses permit additive extensions. Never log CardBatch or TokenResponse data.",
  "oneOf": [
    {
      "$ref": "#/$defs/Catalog"
    },
    {
      "$ref": "#/$defs/Listing"
    },
    {
      "$ref": "#/$defs/CardIssueRequest"
    },
    {
      "$ref": "#/$defs/CardBatch"
    },
    {
      "$ref": "#/$defs/Approval"
    },
    {
      "$ref": "#/$defs/TokenResponse"
    }
  ],
  "$defs": {
    "Identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "Revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^[!-~]+(?![\\s\\S])"
    },
    "ReferencePrice": {
      "description": "Original decimal text; reference price only, never the actual selling price. Null is unknown. Numeric JSON prices are not accepted.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?(?![\\s\\S])"
        }
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}(?![\\s\\S])"
        },
        "label": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              }
            }
          ]
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 10000
              }
            }
          ]
        },
        "type": {
          "enum": [
            "text",
            "email",
            "url",
            "textarea",
            "number",
            "file",
            "select",
            "boolean",
            "image",
            "images"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "collapsed": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}(?![\\s\\S])"
              },
              "label": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                ]
              }
            },
            "required": [
              "value"
            ]
          }
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "Variant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "price": {
          "$ref": "#/$defs/ReferencePrice"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3,5}(?![\\s\\S])"
        },
        "attributes": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "not": {
              "enum": [
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "number",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "price",
        "attributes"
      ]
    },
    "Product": {
      "type": "object",
      "properties": {
        "name": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 120
              }
            }
          ]
        },
        "description": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 20000
              }
            }
          ]
        },
        "logo": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "pattern": "^https://"
        },
        "image": {
          "type": "string",
          "format": "uri",
          "maxLength": 2000,
          "pattern": "^https://"
        },
        "public": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "manual",
            "webhook",
            "script",
            "stock"
          ]
        },
        "delivery": {
          "enum": [
            "content",
            "service"
          ]
        },
        "view_policy": {
          "enum": [
            "repeat",
            "once"
          ]
        },
        "parameters": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "progress_steps": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,39}(?![\\s\\S])"
              },
              "label": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                ]
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "support_email": {
          "type": "string",
          "maxLength": 254
        },
        "revision_policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "attribute_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "label": {
                  "oneOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*(?![\\s\\S])"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 200
                      }
                    }
                  ]
                }
              },
              "required": [
                "attribute_key"
              ]
            }
          ]
        }
      },
      "required": [
        "parameters",
        "outputs",
        "progress_steps"
      ]
    },
    "Listing": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "extore.product-listing.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "shop_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "redemption_url": {
          "type": "string",
          "format": "uri"
        },
        "semantics": {
          "type": "object",
          "properties": {
            "price": {
              "const": "reference"
            },
            "inventory": {
              "const": "not_exported"
            },
            "payment": {
              "const": "external_sales_platform"
            },
            "redemption": {
              "const": "extore"
            }
          },
          "required": [
            "price",
            "inventory",
            "payment",
            "redemption"
          ]
        },
        "product": {
          "$ref": "#/$defs/Product"
        },
        "variants": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Variant"
          }
        }
      },
      "required": [
        "schema",
        "id",
        "shop_id",
        "revision",
        "redemption_url",
        "semantics",
        "product",
        "variants"
      ]
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "extore.commerce-catalog.v1"
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "shop": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "products": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Listing"
          }
        }
      },
      "required": [
        "schema",
        "issuer",
        "shop",
        "grant_id",
        "products"
      ]
    },
    "CardIssueRequest": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}(?![\\s\\S])"
        },
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}(?![\\s\\S])"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "expires": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "expected_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Revision"
            }
          ]
        }
      },
      "required": [
        "product_id",
        "variant_id",
        "count"
      ],
      "additionalProperties": false
    },
    "CLIStockRequest": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}(?![\\s\\S])"
        },
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}(?![\\s\\S])"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "label": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
        },
        "expires": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "expected_revision": {
          "$ref": "#/$defs/Revision"
        },
        "idempotency_key": {
          "$ref": "#/$defs/IdempotencyKey"
        }
      },
      "required": [
        "product_id",
        "variant_id",
        "count",
        "idempotency_key",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "CardBatch": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "extore.card-batch.v1"
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}(?![\\s\\S])"
        },
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}(?![\\s\\S])"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 16,
            "maxLength": 4096,
            "pattern": "^[!-~]+(?![\\s\\S])"
          }
        },
        "created_at": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "recovery_expires": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "quota": {
          "type": "object",
          "properties": {
            "max_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "issued_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "remaining": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "max_count",
            "issued_count",
            "remaining"
          ]
        },
        "variant": {
          "$ref": "#/$defs/Variant"
        }
      },
      "required": [
        "schema",
        "grant_id",
        "product_id",
        "variant_id",
        "batch_id",
        "count",
        "codes",
        "created_at",
        "recovery_expires",
        "quota",
        "variant"
      ]
    },
    "CardLimit": {
      "type": "object",
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}(?![\\s\\S])"
        },
        "variant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}(?![\\s\\S])"
        },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "product_id",
        "variant_id",
        "max_count"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "shop_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "review_digest": {
          "$ref": "#/$defs/Revision"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "products.read",
              "cards.issue"
            ]
          }
        },
        "product_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}(?![\\s\\S])"
          }
        },
        "card_limits": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/CardLimit"
          }
        },
        "grant_expires": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "shop_id",
        "review_digest",
        "scopes",
        "product_ids",
        "grant_expires"
      ],
      "additionalProperties": false
    },
    "TokenResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "refresh_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 4096
        },
        "token_type": {
          "const": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "scope": {
          "enum": [
            "products.read",
            "cards.issue",
            "products.read cards.issue"
          ]
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "grant_expires": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "access_token",
        "refresh_token",
        "token_type",
        "expires_in",
        "scope",
        "grant_id",
        "grant_expires"
      ]
    }
  }
}
